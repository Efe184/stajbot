# Kopyala: .env  — bu dosyayı git'e ekleme
APP_NAME=Staj Başvuru Otomasyonu
DB_PATH=data/stajbot.db
DATA_DIR=data
LOG_LEVEL=INFO           # DEBUG ile ayrıntılı log / hata izleri

# Kullanıcı bilgileri (mail şablonlarında kullanılır)
USER_FULL_NAME=Ad Soyad
USER_PHONE=05xx xxx xx xx
USER_SCHOOL=... Üniversitesi
USER_DEPARTMENT=Bilgisayar Mühendisliği
USER_CLASS=4. sınıf
INTERNSHIP_TERM=2026-2027 Bahar
INTERNSHIP_START=2027-02-15
INTERNSHIP_END=2027-06-15
PROFILE_PATH=data/profil.md

# Hedef şehirler (boş bırakılırsa varsayılan 10 şehir)
TARGET_CITIES=Konya,Ankara,İstanbul,İzmir,Eskişehir,Bursa,Sakarya,Antalya,Mersin,Afyonkarahisar

# Tarama
HTTP_USER_AGENT=StajBot/0.1 (+ogrenci staj basvuru otomasyonu)
CRAWL_DELAY_SEC=1.5
HTTP_TIMEOUT_SEC=20

# Dış servisler
GOOGLE_PLACES_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_MAX_TOKENS=400

# E-posta (Gmail: 2 adımlı doğrulama + uygulama şifresi)
MAIL_MODE=dry            # dry | draft | send
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=Ad Soyad
DAILY_SEND_LIMIT=15
SEND_DELAY_MIN_SEC=120
SEND_DELAY_MAX_SEC=360
SEND_WINDOW=09:00-17:30
SEND_WEEKDAYS_ONLY=true
FOLLOWUP_DAYS=10
MIN_DAYS_BETWEEN_MAILS=14
ATTACHMENTS=data/cv.pdf
